# Supabase project instance URL.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key — safe for client-side use (RLS enforces access).
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Update channel the app polls: stable | beta
EXPO_PUBLIC_RELEASE_CHANNEL=stable

# ── Server-side only (never commit, never prefix with EXPO_PUBLIC_) ──────────
# Needed by scripts/publish-version.js to write to app_versions.
SUPABASE_SERVICE_ROLE_KEY=
